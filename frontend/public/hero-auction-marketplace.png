<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 800" width="100%" height="100%">
  <defs>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#ffffff" />
      <stop offset="50%" stop-color="#f8fafc" />
      <stop offset="100%" stop-color="#f1f5f9" />
    </linearGradient>
    <linearGradient id="blueGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#3b82f6" />
      <stop offset="50%" stop-color="#2563eb" />
      <stop offset="100%" stop-color="#1d4ed8" />
    </linearGradient>
    <radialGradient id="blueGlow" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#2563eb" stop-opacity="0.18" />
      <stop offset="100%" stop-color="#2563eb" stop-opacity="0" />
    </radialGradient>
    <filter id="blurGlow" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="45" />
    </filter>
  </defs>

  <!-- Crisp Luxury Light Background -->
  <rect width="1200" height="800" fill="url(#bgGrad)" />

  <!-- Ambient Sapphire/Royal Blue Glows -->
  <circle cx="900" cy="250" r="380" fill="url(#blueGlow)" filter="url(#blurGlow)" />
  <circle cx="300" cy="600" r="420" fill="url(#blueGlow)" filter="url(#blurGlow)" />

  <!-- Crisp geometric grids and lines -->
  <g stroke="rgba(37, 99, 235, 0.12)" stroke-width="1">
    <line x1="0" y1="200" x2="1200" y2="200" />
    <line x1="0" y1="400" x2="1200" y2="400" />
    <line x1="0" y1="600" x2="1200" y2="600" />
    <line x1="300" y1="0" x2="300" y2="800" />
    <line x1="600" y1="0" x2="600" y2="800" />
    <line x1="900" y1="0" x2="900" y2="800" />
  </g>

  <!-- Luxury Watch Dial Graphic in Sapphire Blue & Slate -->
  <g transform="translate(600, 380)">
    <circle r="220" fill="none" stroke="url(#blueGrad)" stroke-width="3" opacity="0.85" />
    <circle r="200" fill="#ffffff" stroke="rgba(37, 99, 235, 0.3)" stroke-width="1.5" />
    <circle r="180" fill="none" stroke="rgba(37, 99, 235, 0.25)" stroke-width="1" stroke-dasharray="8 6" />
    <!-- Chronograph subdials -->
    <circle cx="-60" cy="0" r="40" fill="#f8fafc" stroke="url(#blueGrad)" stroke-width="1.5" />
    <circle cx="60" cy="0" r="40" fill="#f8fafc" stroke="url(#blueGrad)" stroke-width="1.5" />
    <circle cx="0" cy="70" r="40" fill="#f8fafc" stroke="url(#blueGrad)" stroke-width="1.5" />
    <!-- Watch Hands -->
    <line x1="0" y1="0" x2="90" y2="-70" stroke="url(#blueGrad)" stroke-width="5" stroke-linecap="round" />
    <line x1="0" y1="0" x2="-50" y2="-90" stroke="#0f172a" stroke-width="4" stroke-linecap="round" />
    <circle r="8" fill="url(#blueGrad)" />
  </g>

  <!-- Typography & Watermark -->
  <text x="80" y="120" font-family="'Playfair Display', Georgia, serif" font-size="44" font-weight="700" fill="#1e3a8a" letter-spacing="2">
    CURATED LUXURY LOTS
  </text>
  <text x="80" y="160" font-family="'Inter', sans-serif" font-size="18" font-weight="500" fill="#475569" letter-spacing="4">
    VERIFIED · ADMIN REVIEWED · TRANSPARENT BIDDING
  </text>

  <g transform="translate(80, 680)">
    <rect width="240" height="60" rx="30" fill="rgba(37, 99, 235, 0.1)" stroke="url(#blueGrad)" stroke-width="1.5" />
    <text x="120" y="36" font-family="'Inter', sans-serif" font-size="16" font-weight="600" fill="#2563eb" text-anchor="middle">
      LIVE AUCTIONS NOW
    </text>
  </g>
</svg>
