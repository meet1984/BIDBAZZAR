# Apache configuration for cPanel Single Page Application (SPA) routing
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # The API is mounted as a cPanel/Passenger application. Never rewrite API
  # requests to the frontend index.html fallback.
  RewriteRule ^api(?:/|$) - [L]
  
  # Allow direct access to existing static files or directories
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Route all other SPA client requests to index.html
  RewriteRule ^ index.html [L]
</IfModule>

# Caching headers for production static assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/json "access plus 0 seconds"
</IfModule>
