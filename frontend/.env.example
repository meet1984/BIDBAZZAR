# API Endpoint configuration
# In local development with Vite dev server proxy: /api
# In production: https://api.yourdomain.com/api (or https://your-backend.onrender.com/api)
VITE_API_URL=/api

# Backend Base URL for resolving static assets (/uploads)
# Optional in dev (falls back to origin or derives from VITE_API_URL)
# In production (if backend is on a separate domain): https://api.yourdomain.com
# VITE_BACKEND_URL=https://api.yourdomain.com
