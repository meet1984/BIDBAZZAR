{
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noUncheckedIndexedAccess": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022",
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts", "tests/**/*.ts", "scripts/**/*.ts", "vitest.config.ts"],
  "exclude": [
    "src/modules/payments/**/*",
    "src/modules/delivery/**/*",
    "tests/phase4_payment_boundary.test.ts",
    "tests/phase5_delivery_disputes.test.ts",
    "tests/phase3_order_lifecycle.test.ts",
    "tests/phase6_reviews_trust_profiles.test.ts",
    "tests/phase7_notifications.test.ts",
    "tests/phase8_deep_coverage.test.ts"
  ]
}
