NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

DB_HOST=127.0.0.1
# DB_PORT=3306
DB_USER=bidmylot
DB_PASSWORD=change-this-database-password
DB_NAME=bidmylot
DB_CONNECTION_LIMIT=10

# Use a long, random value of at least 32 characters.
JWT_ACCESS_SECRET=change-this-to-a-long-random-access-token-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=7
COOKIE_SECURE=false
TRUST_PROXY_HOPS=1
# Production requires COOKIE_SECURE=true and HTTPS-only CLIENT_ORIGIN values.

UPLOAD_DIR=uploads
PRIVATE_UPLOAD_DIR=private_uploads
MAX_UPLOAD_BYTES=5242880

# Used only by npm run db:seed:admin. Admins cannot register through the API.
ADMIN_NAME=BidMyLot Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password

# SMTP Mailer Configuration (Mailtrap or any generic SMTP provider for local dev/testing)
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_SECURE=false
SMTP_USER=your-mailtrap-username
SMTP_PASSWORD=your-mailtrap-password
SMTP_FROM_NAME=BidMyLot
SMTP_FROM_EMAIL=no-reply@bidmylot.com
SUPPORT_NOTIFICATION_EMAIL=support@bidmylot.com
